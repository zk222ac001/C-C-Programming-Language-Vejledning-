#include <stdio.h>
#include <string.h> // Bruges til funktionen strcspn()

int main() {
    // -------------------------------------------------
    // Trin 1: Opret variabler
    // -------------------------------------------------
    char navn[50];  // Tekst med plads til maksimalt 49 tegn
    int alder;      // Helt tal
    float hoejde;   // Decimaltal
    double vaegt;   // Decimaltal med større præcision
    char koen;      // Ét enkelt tegn

    // -------------------------------------------------
    // Trin 2: Læs navn fra tastaturet
    // -------------------------------------------------
    printf("Indtast dit navn: ");
    // fgets() kan læse et navn, som indeholder mellemrum
     // fgets() gemmer normalt Enter-tasten som '\n'.
    // Denne linje finder og fjerner linjeskiftet (new line character \n).
    fgets(navn, sizeof(navn), stdin);   
    navn[strcspn(navn, "\n")] = '\0';

    // -------------------------------------------------
    // Trin 3: Læs alder
    // -------------------------------------------------
    printf("Indtast din alder: ");
    // scanf_s() returnerer 1, hvis et helt tal blev læst
    if (scanf_s("%d", &alder) != 1) {
        printf("Fejl: Alderen skal være et helt tal.\n");
        return 1; // Afslut programmet med en fejlkode
    }
    // -------------------------------------------------
    // Trin 4: Læs højde
    // -------------------------------------------------
    printf("Indtast din højde i meter, f.eks. 1.85: ");
    // %f bruges til en float-variabel
    if (scanf_s("%f", &hoejde) != 1) {
        printf("Fejl: Højden skal være et tal med punktum.\n");
        return 1;
    }
    // -------------------------------------------------
    // Trin 5: Læs vægt
    // -------------------------------------------------

    printf("Indtast din vægt i kg, f.eks. 75.5: ");

    // %lf bruges til en double-variabel
    if (scanf_s("%lf", &vaegt) != 1) {
        printf("Fejl: Vægten skal være et tal med punktum.\n");
        return 1;
    }
    // -------------------------------------------------
    // Trin 6: Læs køn
    // -------------------------------------------------
    printf("Indtast dit køn (M/K): ");

    /*
       Mellemrummet før %c får scanf_s() til at ignorere
       linjeskift og andre mellemrum fra tidligere input.

       sizeof(koen) fortæller scanf_s(), at der kun er
       plads til ét tegn i variablen.
    */
    if (scanf_s(" %c", &koen, (unsigned)sizeof(koen)) != 1) {
        printf("Fejl: Du skal indtaste ét tegn.\n");
        return 1;
    }
    // -------------------------------------------------
    // Trin 7: Udskriv de indtastede oplysninger
    // -------------------------------------------------
    printf("\n--- Dine oplysninger ---\n");
    printf("Mit navn er %s\n", navn);
    printf("Min alder er %d år\n", alder);

    // .2 betyder, at der udskrives to decimaler
    printf("Min højde er %.2f meter\n", hoejde);
    printf("Min vægt er %.2f kg\n", vaegt);
    printf("Mit køn er %c\n", koen);

    // 0 betyder, at programmet blev afsluttet uden fejl
    return 0;
}
